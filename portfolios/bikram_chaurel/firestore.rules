rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for all portfolio data
    match /{document=**} {
      allow read: true;
      // Write is blocked from client — admin writes come through the browser
      // after password verification. For now allow write (tighten later with Firebase Auth).
      allow write: true;
    }
  }
}
